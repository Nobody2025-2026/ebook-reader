# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
build/
npm-debug.log*

# 不提交 lock：macOS 生成的 package-lock.json 只含 darwin 平台可选依赖，
# 会导致 ubuntu/macos CI 上 npm install 解析失败；交给各 CI 按平台重新解析。
package-lock.json

# Editors
.idea/
.vscode/

# 本地环境与密钥
.env
.env.local

# WorkBuddy 工作区数据（含项目记忆，不入库）
.workbuddy/

# Node 端跑解析时落盘的临时资源（浏览器端走 blob URL，不写盘）
images/

# 测试用的真实电子书，体积大且有版权，只放本地不入库
books/

# 真机验收时 Playwright 的截图，偶然产物
.screenshots/

# Tauri 桌面版：Rust 编译产物体积可达数 GB，由 CI / 本地按需生成，不入库
src-tauri/target/
